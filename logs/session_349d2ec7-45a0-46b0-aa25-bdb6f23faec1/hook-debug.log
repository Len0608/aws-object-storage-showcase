eld values (Text wrappers unwrapped to strings)\n        \"\"\"\n        result = {}\n        for k, v in asdict(self).items():\n            if v is not None:\n                # Extract value from Text wrapper\n                result[k] = v.value if isinstance(v, Text) else v\n        return result\n\n    def clear(self):\n        \"\"\"Reset all fields to None.\"\"\"\n        self.status = None\n        self.object_count = None\n","numLines":55,"startLine":1,"totalLines":55}},"tool_use_id":"toolu_01H6PymecEriChMzK5N2Bwtm","duration_ms":1}

